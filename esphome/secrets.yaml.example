# 复制成 secrets.yaml 并填入你自己的值
# ⚠️ secrets.yaml 不要提交到 git

wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# 断网时的备用热点密码
ap_password: "fallback-ap-password"

# ESPHome API 加密密钥（用 `openssl rand -base64 32` 生成）
api_key: "REPLACE_WITH_BASE64_32BYTE_KEY"

# OTA 升级密码
ota_password: "your-ota-password"
